# Server-side email configuration for contact form delivery
# You can use either SMTP_* keys or EMAIL_* keys.

# Option A: SMTP_* keys
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Option B: EMAIL_* keys
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=your-smtp-username
# EMAIL_PASSWORD=your-smtp-password

# Where notification emails are delivered
ADMIN_EMAIL=hello@oceanex.group

# Optional sender address shown in email clients
EMAIL_FROM=Oceanex Website <no-reply@oceanex.group>
